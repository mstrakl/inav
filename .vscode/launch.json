{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug JETFURYH743",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "serverpath": "/usr/bin/openocd",
      "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
      "executable": "${workspaceFolder}/build/bin/JETFURYH743.elf",
      "configFiles": [
        "${workspaceFolder}/board/h7fc.cfg"
      ],
      "preLaunchCommands": [
        "set substitute-path /src ${workspaceFolder}"
      ],
      "runToEntryPoint": "main",
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw"
    },

    {
      "name": "Debug AIRDATAFC1",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "openocd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "serverpath": "/usr/bin/openocd",
      "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
      "executable": "${workspaceFolder}/build/bin/AIRDATAFC1.elf",
      "configFiles": [
        "${workspaceFolder}/board/f4fc.cfg"
      ],
      "preLaunchCommands": [
        "set substitute-path /src ${workspaceFolder}"
      ],
      "runToEntryPoint": "main",
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw"
    },



    {
      "name": "Attach JETFURYH743",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "openocd",
      "gdbPath": "/usr/bin/gdb-multiarch",
      "serverpath": "/usr/bin/openocd",
      "objdumpPath": "/usr/bin/arm-none-eabi-objdump",
      "executable": "${workspaceFolder}/build/bin/JETFURYH743.elf",
      "configFiles": [
        "${workspaceFolder}/board/h7fc.cfg"
      ],
      "preLaunchCommands": [
        "set substitute-path /src ${workspaceFolder}"
      ],
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw"
    }
  ]
}